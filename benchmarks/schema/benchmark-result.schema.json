{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Result Collection",
  "type": "object",
  "required": [
    "schema_version",
    "results"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "notice": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "benchmark_id",
          "benchmark_version",
          "category",
          "metric_id",
          "metric_direction",
          "score",
          "unit",
          "model_id",
          "model_version",
          "evaluation_date",
          "provenance",
          "source",
          "reproducibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "benchmark_id": {
            "type": "string",
            "minLength": 1
          },
          "benchmark_version": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_direction": {
            "enum": [
              "higher_is_better",
              "lower_is_better"
            ]
          },
          "score": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "evaluation_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "provenance": {
            "enum": [
              "independent",
              "official",
              "community",
              "synthetic",
              "estimated"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "accessed_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "reproducibility": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_attempted",
                  "partial",
                  "reproduced",
                  "failed"
                ]
              }
            }
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1
          },
          "standard_deviation": {
            "type": "number",
            "minimum": 0
          },
          "confidence_interval_95": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}